{
  "name": "specification-website-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing The Website Specification as queryable tools.",
  "license": "MIT",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "pretest": "npm run build:data",
    "test": "node --experimental-strip-types --import ./ts-resolve-hook.mjs scripts/test-protocol.mjs",
    "predev": "npm run build:data",
    "dev": "wrangler dev --port 31338",
    "predeploy": "npm run build:data",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0",
    "yaml": "^2.6.0"
  }
}
