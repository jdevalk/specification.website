{
  "name": "specification-website-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing The Website Specification as queryable tools.",
  "license": "MIT",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "pretest": "npm run build:data",
    "test": "node --experimental-strip-types --import ./ts-resolve-hook.mjs scripts/test-protocol.mjs && node --test scripts/test-feedback.mjs",
    "predev": "npm run build:data",
    "dev": "wrangler dev --port 31338",
    "predeploy": "npm run build:data",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261118.0-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "undici": "7.30.1"
  }
}
