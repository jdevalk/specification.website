{
  "$comment": "Maps spec slugs to HTTP Archive custom_metrics JSON fields in httparchive.crawl.pages. Each condition has a field within that STRUCT and a JSONPath relative to that field. combine: any counts a page when at least one condition holds.",
  "metrics": [
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/gpc.json\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/gpc.json",
      "slug": "gpc-json"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/security.txt\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/security.txt",
      "slug": "security-txt"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/assetlinks.json\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/assetlinks.json",
      "slug": "assetlinks-json"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/apple-app-site-association\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/apple-app-site-association",
      "slug": "apple-app-site-association"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/change-password\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/change-password",
      "slug": "change-password"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/webauthn\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/webauthn",
      "slug": "webauthn"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/ai-catalog.json\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/ai-catalog.json (agent catalog)",
      "slug": "api-catalog"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/ard.json\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/ard.json",
      "note": "Measured from the October 2026 crawl onward (metric added September 2026).",
      "slug": "agentic-resource-discovery"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/nodeinfo\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/nodeinfo",
      "note": "Needs the well-known metric extension to land upstream first.",
      "slug": "nodeinfo"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/webfinger\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/webfinger",
      "note": "Needs the well-known metric extension to land upstream first.",
      "slug": "webfinger"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/oauth-authorization-server\".found",
