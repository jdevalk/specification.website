          "field": "well_known"
        }
      ],
      "label": "/.well-known/traffic-advice",
      "note": "Needs the well-known metric extension to land upstream first.",
      "slug": "traffic-advice"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.llms_txt_validation.valid",
          "op": "eq",
          "value": "true",
          "field": "other"
        }
      ],
      "label": "/llms.txt (valid)",
      "slug": "llms-txt"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.status",
          "op": "eq",
          "value": "200",
          "field": "robots_txt"
        }
      ],
      "label": "/robots.txt (HTTP 200)",
      "slug": "robots-txt"
    },
    {
      "combine": "any",
      "conditions": [
        {
          "jsonPath": "$.record_counts.by_useragent.\"gptbot\"",
          "op": "exists",
          "field": "robots_txt"
        },
        {
          "jsonPath": "$.record_counts.by_useragent.\"claudebot\"",
          "op": "exists",
          "field": "robots_txt"
        },
        {
          "jsonPath": "$.record_counts.by_useragent.\"ccbot\"",
          "op": "exists",
          "field": "robots_txt"
        },
        {
          "jsonPath": "$.record_counts.by_useragent.\"anthropic-ai\"",
          "op": "exists",
          "field": "robots_txt"
        },
        {
          "jsonPath": "$.record_counts.by_useragent.\"google-extended\"",
          "op": "exists",
          "field": "robots_txt"
        },
        {
          "jsonPath": "$.record_counts.by_useragent.\"perplexitybot\"",
          "op": "exists",
          "field": "robots_txt"
        },
        {
          "jsonPath": "$.record_counts.by_useragent.\"bytespider\"",
          "op": "exists",
          "field": "robots_txt"
        }
      ],
      "label": "robots.txt rules naming AI crawlers",
      "slug": "robots-for-ai-crawlers"
    }
  ]
}
