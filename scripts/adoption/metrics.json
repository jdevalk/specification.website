          "field": "well_known"
        }
      ],
      "label": "/.well-known/oauth-authorization-server",
      "note": "Needs the well-known metric extension to land upstream first.",
      "slug": "oauth-authorization-server"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/oauth-protected-resource\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/oauth-protected-resource",
      "note": "Needs the well-known metric extension to land upstream first.",
      "slug": "oauth-protected-resource"
    },
    {
      "conditions": [
        {
          "jsonPath": "$.\"/.well-known/openid-configuration\".found",
          "op": "eq",
          "value": "true",
          "field": "well_known"
        }
      ],
      "label": "/.well-known/openid-configuration",
      "note": "Needs the well-known metric extension to land upstream first.",
      "slug": "openid-configuration"
