---
import { getCollection, render } from "astro:content";
import SpecLayout from "~/layouts/SpecLayout.astro";
import adoptionDataRaw from "~/data/adoption.json";

interface AdoptionMetric {
  label: string;
  pages: number;
  pagesPct: number;
  origins: number;
  originsPct: number;
}

interface AdoptionData {
  crawl: string | null;
  generatedAt: string | null;
  origins: number;
  metrics: Record<string, AdoptionMetric>;
}

const adoptionData = adoptionDataRaw as AdoptionData;

export async function getStaticPaths() {
  const all = await getCollection("spec", ({ data }) => !data.draft);
  return all.map((entry) => {
    const slug = entry.data.slug ?? entry.id.split("/").pop()!;
    return {
      params: { category: entry.data.category, slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const all = await getCollection("spec", ({ data }) => !data.draft);
const related = entry.data.relatedSlugs
  .map((rs: string) => {
    const found = all.find(
      (e) => (e.data.slug ?? e.id.split("/").pop()) === rs,
    );
    if (!found) return null;
    return {
      title: found.data.title,
      href: `/spec/${found.data.category}/${found.data.slug ?? found.id.split("/").pop()}/`,
      status: found.data.status,
    };
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);

const slug = entry.data.slug ?? entry.id.split("/").pop()!;
const adoption = adoptionData.metrics[slug] ?? null;
---

<SpecLayout
  title={entry.data.title}
  summary={entry.data.summary}
  category={entry.data.category}
  status={entry.data.status}
  sources={entry.data.sources}
  related={related}
  updated={entry.data.updated}
  appliesTo={entry.data.appliesTo}
  slug={slug}
  adoption={adoption}
  adoptionCrawl={adoptionData.crawl}
  adoptionSampleSize={adoptionData.origins}
>
  <Content />
</SpecLayout>
